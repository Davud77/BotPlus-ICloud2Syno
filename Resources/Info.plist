<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>com.synologyphotosync.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SynologyPhotoSync</string>
    <key>CFBundleDisplayName</key>
    <string>SynologyPhotoSync</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.3.0</string>
    <key>CFBundleVersion</key>
    <string>4</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Приложение доступно в Dock и строке меню -->
    <key>LSUIElement</key>
    <false/>

    <!-- Описание причины доступа к системной медиатеке Photos -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>SynologyPhotoSync требуется доступ к медиатеке Apple Photos для побитовой выгрузки оригиналов фото, видео, Live Photos и структуры альбомов на ваш сервер Synology NAS.</string>

    <!-- Разрешение локальных подключений к NAS по HTTP / HTTPS (включая самоподписанные сертификаты) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
